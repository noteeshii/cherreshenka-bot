{
  "name": "cherreshenka-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:overlay": "vite",
    "build:overlay": "vue-tsc -b && vite build",
    "preview:overlay": "vite preview",
    "start": "node --env-file-if-exists=.env main.ts",
    "dev": "node --watch --env-file-if-exists=.env main.ts",
    "checkTypes": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run format:check && npm run checkTypes && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "diagnose:music": "node --env-file-if-exists=.env scripts/diagnose-music.ts"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vue-tsc": "^3.3.8",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "prettier": "3.9.6",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@streamerbot/client": "^2.0.1",
    "ws": "^8.21.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.40"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "imports": {
    "#actions": "./actions/index.ts",
    "#actions/*.ts": "./actions/*.ts",
    "#actions/*": "./actions/*.ts",
    "#extensions": "./extensions/index.ts",
    "#extensions/*.ts": "./extensions/*.ts",
    "#extensions/*": "./extensions/*.ts",
    "#utils": "./utils/index.ts"
  }
}
